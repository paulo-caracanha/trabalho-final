        {
          "name": "Confirmar o novo pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/confirmar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
