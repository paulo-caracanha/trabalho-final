{
  "info": {
    "name": "API de produtos e pedidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Confirmar e cancelar",
      "item": [
        {
          "name": "Cadastrar produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/produtos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teclado\",\n  \"descricao\": \"Teclado USB\",\n  \"preco\": 100,\n  \"quantidade\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"produtoId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar pedido com desconto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 10,\n  \"tipoDesconto\": \"ATACADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"pedidoId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/confirmar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Conferir estoque depois da confirmacao",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/produtos/{{produtoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Tentar confirmar novamente",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/confirmar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/cancelar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Conferir devolucao do estoque",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/produtos/{{produtoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Entregar pedido",
      "item": [
        {
          "name": "Criar outro pedido",
          "request": {
            "method": "POST",
            "header": [
              {
