        {
          "name": "Entregar pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/entregar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Tentar cancelar depois da entrega",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/cancelar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Produtos e CEP",
      "item": [
        {
          "name": "Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/produtos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar produto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teclado USB\",\n  \"preco\": 110,\n  \"quantidade\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar CEP",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cep/01001000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar CEP novamente pelo cache",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cep/01001000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir produto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/produtos/{{produtoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
